#!/bin/sh
# Apply the zone files to Cloudflare. This changes production DNS.
#
# Only .github/workflows/deploy.yml should run this. Run it by hand only when
# you are recovering from a failed deploy, and read docs/runbook.md first.
#
# Needs CLOUDFLARE_TOKEN in the environment with write access.
set -eu

exec octodns-sync --config-file=./config/config.yaml --doit "$@"
